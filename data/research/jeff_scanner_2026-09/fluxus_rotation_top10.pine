//@version=6
// Fluxus 行业组轮动 Top10 → Discord webhook
// 用法: 挂在任意图表的 10 分钟周期上 → 创建警报 → 条件选本指标的「Any alert() function call」
//      → Webhook URL 填 Discord webhook → 到期设 Open-ended (Premium)。
// 名单: Jeff Sun 2026-09-05 行业组 ETF 表 48 个砍 8 个商品/重复项 (SVIX/USO/UNG/PALL/AMLP/GUNR/GXC/ILF)。
// 消息体是 Discord JSON ({"content": ...})。若 Discord 回 400, 在 webhook URL 末尾加 /slack 并把 content 改成 text。
indicator("Fluxus 行业组轮动 Top10", overlay = false, dynamic_requests = true)

int  topN       = input.int(10, "Top N", minval = 1, maxval = 20)
bool showBottom = input.bool(true, "附带垫底 3 个")
bool rthOnly    = input.bool(true, "只在美股常规时段推送")

var string[] syms = array.from(
     "BLOK", "BUZZ", "KCE",  "EWY",  "AIQ",  "BOAT", "CNBS", "SLX",  "DRAM", "ARKF",
     "IBIT", "IAI",  "ARKW", "MAGS", "ARGT", "FXI",  "KURE", "KIE",  "ARKK", "GNR",
     "PBE",  "EWZ",  "MOO",  "WOOD", "NLR",  "URA",  "SIL",  "ETHA", "IHF",  "XOP",
     "WGMI", "HYDR", "ESPO", "XRPI", "XME",  "XHS",  "FDN",  "FCG",  "SOLZ", "OIH")
var string[] names = array.from(
     "Blockchain", "Social Media", "Capital Markets", "South Korea", "AI Software", "Shipping", "Cannabis", "Steel", "Memory", "ARK Fintech",
     "Bitcoin", "Broker-Dealers", "ARK Next-Gen", "Mag 7", "Argentina", "China Large-Cap", "China Health", "Insurance", "ARK Innovation", "Nat Resources",
     "Biotech", "Brazil", "Agriculture", "Timber", "Nuclear", "Uranium", "Silver Miners", "Ether", "Health Providers", "Oil&Gas E&P",
     "Internet Infra", "Hydrogen", "E-Sports", "XRP", "Metals&Mining", "Health Facilities", "US Internet", "NatGas E&P", "Solana", "Oil Services")

f_chg(string s) =>
    request.security(s, "D", 100.0 * (close / close[1] - 1))

var float[] chgs = array.new_float()
array.clear(chgs)
for i = 0 to array.size(syms) - 1
    array.push(chgs, nz(f_chg(array.get(syms, i)), -999))

// 图上画个中位数当呼吸线
float med = array.median(chgs)
plot(med, "行业组涨幅中位数", color = med >= 0 ? color.teal : color.maroon, style = plot.style_columns)
hline(0)

f_line(int rank, int i) =>
    float c = array.get(chgs, i)
    c == -999 ? "" : "\\n" + str.tostring(rank) + ". **" + array.get(syms, i) + "** " + array.get(names, i) + "  " + (c >= 0 ? "+" : "") + str.tostring(c, "0.00") + "%"

bool inRth = not na(time(timeframe.period, "0930-1600", "America/New_York"))
if barstate.isconfirmed and (not rthOnly or inRth)
    int[] idx = array.sort_indices(chgs, order.descending)
    string body = "**行业组动量 Top" + str.tostring(topN) + "**  (日涨幅, " + timeframe.period + "m tick)"
    for r = 0 to topN - 1
        body += f_line(r + 1, array.get(idx, r))
    if showBottom
        body += "\\n— 垫底 —"
        int n = array.size(idx)
        for r = n - 3 to n - 1
            body += f_line(r + 1, array.get(idx, r))
    alert("{\"content\": \"" + body + "\"}", alert.freq_once_per_bar)
