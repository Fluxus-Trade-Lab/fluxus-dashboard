# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# Node / Frontend
node_modules/
frontend/dist/
.env
.env.local

# Data (keep output + history, ignore raw bulk)
data/raw/*.csv
data/raw/*.tmp

# GEX: legacy SPX->pine launchd tool output + all logs live in data/gex/.
# The new GEX engine commits its own gex_YYYYMMDD.json / latest.json / brief_*.html
# there, so ignore the legacy files and logs to keep `git add data/gex` clean.
data/gex/gex_SPX_*
data/gex/*.log
data/gex/*.pine

