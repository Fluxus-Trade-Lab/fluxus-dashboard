# VITE_WHOP_CLIENT_ID — Whop OAuth app's client_id (public value, safe to
# ship in the built bundle; PKCE replaces the need for a client_secret here,
# see frontend/src/lib/whopAuth.js).
#
# Unset today. Activating "会员登录" on the dashboard needs someone with Whop
# account access to:
#   1. Register an OAuth app in Whop's Developer Dashboard.
#   2. Add this site's origin as an allowed redirect URI (exact match,
#      no path — see getRedirectUri() in whopAuth.js).
#   3. Copy the client_id here / into Vercel's project env vars.
# Until then the login button renders but stays disabled with an honest
# "配置中" tooltip — see frontend/src/components/public/PublicHeader.jsx.
VITE_WHOP_CLIENT_ID=

# VITE_WHOP_ACCESS_PASS_ID — the access pass / experience ID whose
# `/me/has_access/:id` result decides whether the logged-in button shows
# "Fluxus 会员" instead of the plain "已验证会员" label (display only — see
# T-0925-75/T-0925-77, this never gates page content). Also unset today;
# same Whop Developer Dashboard lookup as the client_id above. `fetchHasAccess`
# in whopAuth.js documents that the has_access endpoint's exact version
# prefix (v1 vs v5) wasn't pinned down with confidence — confirm at
# docs.whop.com/api-reference before treating this as load-bearing.
VITE_WHOP_ACCESS_PASS_ID=
